<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:contract="urn:mcp-bpmn:engine-contract"
  id="Definitions_ContractFixture"
  targetNamespace="urn:mcp-bpmn:engine-contract">
  <bpmn:process id="Process_ContractFixture" name="Imported &amp; Nested" isExecutable="true">
    <bpmn:extensionElements>
      <contract:metadata key="must-round-trip" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start_ContractFixture" name="Start" />
    <bpmn:subProcess id="SubProcess_ContractFixture" name="Review &lt;details&gt;">
      <bpmn:task id="Task_Nested" name="Nested &amp; quoted &quot;task&quot;">
        <bpmn:extensionElements>
          <contract:metadata key="nested-extension" />
        </bpmn:extensionElements>
      </bpmn:task>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_ContractFixture" name="End" />
    <bpmn:sequenceFlow id="Flow_ToSubProcess" name="enter &amp; inspect" sourceRef="Start_ContractFixture" targetRef="SubProcess_ContractFixture" />
    <bpmn:sequenceFlow id="Flow_FromSubProcess" name="leave &gt; done" sourceRef="SubProcess_ContractFixture" targetRef="End_ContractFixture" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ContractFixture">
    <bpmndi:BPMNPlane id="BPMNPlane_ContractFixture" bpmnElement="Process_ContractFixture">
      <bpmndi:BPMNShape id="Start_ContractFixture_di" bpmnElement="Start_ContractFixture">
        <dc:Bounds x="80" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_ContractFixture_di" bpmnElement="SubProcess_ContractFixture" isExpanded="true">
        <dc:Bounds x="180" y="80" width="300" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Nested_di" bpmnElement="Task_Nested">
        <dc:Bounds x="280" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ContractFixture_di" bpmnElement="End_ContractFixture">
        <dc:Bounds x="550" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToSubProcess_di" bpmnElement="Flow_ToSubProcess">
        <di:waypoint x="116" y="160" />
        <di:waypoint x="180" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FromSubProcess_di" bpmnElement="Flow_FromSubProcess">
        <di:waypoint x="480" y="160" />
        <di:waypoint x="550" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
