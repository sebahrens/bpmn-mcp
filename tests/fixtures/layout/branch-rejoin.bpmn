<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Branch" targetNamespace="http://mcp-bpmn.test/layout">
  <bpmn:process id="Process_Branch" isExecutable="false">
    <bpmn:documentation>Exclusive branch with two paths that rejoin.</bpmn:documentation>
    <bpmn:startEvent id="Start_Branch"><bpmn:outgoing>Flow_Branch_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Split" name="Approved?" gatewayDirection="Diverging"><bpmn:incoming>Flow_Branch_1</bpmn:incoming><bpmn:outgoing>Flow_Branch_Approve</bpmn:outgoing><bpmn:outgoing>Flow_Branch_Reject</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Approve" name="Approve"><bpmn:incoming>Flow_Branch_Approve</bpmn:incoming><bpmn:outgoing>Flow_Branch_3</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_Reject" name="Reject"><bpmn:incoming>Flow_Branch_Reject</bpmn:incoming><bpmn:outgoing>Flow_Branch_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Join" gatewayDirection="Converging"><bpmn:incoming>Flow_Branch_3</bpmn:incoming><bpmn:incoming>Flow_Branch_4</bpmn:incoming><bpmn:outgoing>Flow_Branch_5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Branch"><bpmn:incoming>Flow_Branch_5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Branch_1" sourceRef="Start_Branch" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="Flow_Branch_Approve" name="yes" sourceRef="Gateway_Split" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="Flow_Branch_Reject" name="no" sourceRef="Gateway_Split" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="Flow_Branch_3" sourceRef="Task_Approve" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Branch_4" sourceRef="Task_Reject" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Branch_5" sourceRef="Gateway_Join" targetRef="End_Branch" />
  </bpmn:process>
</bpmn:definitions>
