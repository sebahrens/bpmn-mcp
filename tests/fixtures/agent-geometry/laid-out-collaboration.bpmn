<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_LaidOutCollaboration"
  targetNamespace="urn:mcp-bpmn:agent-geometry">
  <bpmn:process id="Process_Alpha" name="Alpha process" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Alpha">
      <bpmn:lane id="Lane_1" name="Handling">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Request received" />
    <bpmn:subProcess id="SubProcess_1" name="Handle request">
      <bpmn:task id="Task_A" name="Check" />
      <bpmn:task id="Task_B" name="Confirm" />
      <bpmn:sequenceFlow id="Flow_Inner" name="ok" sourceRef="Task_A" targetRef="Task_B" />
    </bpmn:subProcess>
    <bpmn:endEvent id="EndEvent_1" name="Request handled" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="SubProcess_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="SubProcess_1" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmn:process id="Process_Beta" name="Beta process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_2" name="Idle" />
    <bpmn:receiveTask id="ReceiveTask_1" name="Receive request" />
    <bpmn:endEvent id="EndEvent_2" name="Answered" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="StartEvent_2" targetRef="ReceiveTask_1" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="ReceiveTask_1" targetRef="EndEvent_2" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_1" name="Laid out collaboration">
    <bpmn:participant id="Participant_1" name="Alpha" processRef="Process_Alpha" />
    <bpmn:participant id="Participant_2" name="Beta" processRef="Process_Beta" />
    <bpmn:messageFlow id="MessageFlow_1" name="request" sourceRef="Task_B" targetRef="ReceiveTask_1" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_LaidOutCollaboration">
    <bpmndi:BPMNPlane id="Plane_LaidOutCollaboration" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="760" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="730" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="240" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel id="StartEvent_1_label">
          <dc:Bounds x="214" y="205" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_1_di" bpmnElement="SubProcess_1" isExpanded="true">
        <dc:Bounds x="330" y="122" width="340" height="116" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_A_di" bpmnElement="Task_A">
        <dc:Bounds x="350" y="142" width="100" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_B_di" bpmnElement="Task_B">
        <dc:Bounds x="530" y="142" width="100" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="720" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel id="EndEvent_1_label">
          <dc:Bounds x="694" y="205" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_2_di" bpmnElement="Participant_2" isHorizontal="true">
        <dc:Bounds x="160" y="410" width="760" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_2_di" bpmnElement="StartEvent_2">
        <dc:Bounds x="200" y="492" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveTask_1_di" bpmnElement="ReceiveTask_1">
        <dc:Bounds x="400" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_2_di" bpmnElement="EndEvent_2">
        <dc:Bounds x="600" y="492" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="276" y="180" />
        <di:waypoint x="330" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Inner_di" bpmnElement="Flow_Inner">
        <di:waypoint x="450" y="172" />
        <di:waypoint x="530" y="172" />
        <bpmndi:BPMNLabel id="Flow_Inner_label">
          <dc:Bounds x="460" y="150" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="670" y="180" />
        <di:waypoint x="720" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="236" y="510" />
        <di:waypoint x="400" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="500" y="510" />
        <di:waypoint x="600" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <di:waypoint x="580" y="202" />
        <di:waypoint x="580" y="440" />
        <di:waypoint x="450" y="440" />
        <di:waypoint x="450" y="470" />
        <bpmndi:BPMNLabel id="MessageFlow_1_label">
          <dc:Bounds x="500" y="380" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
