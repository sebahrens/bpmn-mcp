      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObjectReference_Invoice_di" bpmnElement="DataObjectReference_Invoice">
        <dc:Bounds x="272" y="60" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="273" y="117" width="35" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_3escalation_di" bpmnElement="Activity_3escalation" isExpanded="true">
        <dc:Bounds x="240" y="430" width="350" height="160" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_1escalated_di" bpmnElement="Event_1escalated">
        <dc:Bounds x="280" y="492" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="277" y="535" width="47" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_4notify_di" bpmnElement="Activity_4notify">
        <dc:Bounds x="370" y="470" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_2notified_di" bpmnElement="Event_2notified">
        <dc:Bounds x="522" y="492" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0compensate_di" bpmnElement="Event_0compensate">
        <dc:Bounds x="272" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="256" y="265" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0start_di" bpmnElement="Flow_0start">
        <di:waypoint x="188" y="200" />
        <di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1review_di" bpmnElement="Flow_1review">
        <di:waypoint x="340" y="200" />
        <di:waypoint x="395" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2archive_di" bpmnElement="Flow_2archive">
        <di:waypoint x="445" y="200" />
        <di:waypoint x="500" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="447" y="182" width="47" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3end_di" bpmnElement="Flow_3end">
        <di:waypoint x="600" y="200" />
        <di:waypoint x="652" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4notify_di" bpmnElement="Flow_4notify">
        <di:waypoint x="316" y="510" />
        <di:waypoint x="370" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5notified_di" bpmnElement="Flow_5notified">
