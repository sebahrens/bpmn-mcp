        <dc:Bounds x="240" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_0approved_di" bpmnElement="Gateway_0approved" isMarkerVisible="true">
        <dc:Bounds x="395" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="392" y="145" width="57" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1archive_di" bpmnElement="Activity_1archive">
        <dc:Bounds x="500" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0done_di" bpmnElement="Event_0done">
        <dc:Bounds x="652" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="632" y="225" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_2undo_di" bpmnElement="Activity_2undo">
        <dc:Bounds x="380" y="300" width="100" height="80" />
