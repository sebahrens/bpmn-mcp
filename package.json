{
  "name": "mcp-bpmn-server",
  "version": "0.3.0",
  "description": "MCP server for AI-powered BPMN diagram creation with Mermaid-to-BPMN conversion",
  "bin": {
    "mcp-bpmn-server": "./dist/server/index.js"
  },
  "files": [
    "dist",
    "bin",
    "mcp.json",
    "skills",
    "evals",
    ".codex-plugin",
    ".claude-plugin",
    ".mcp.json",
    "npm-shrinkwrap.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:bundle": "node build-cjs.js",
    "build:watch": "tsc --watch",
    "dev": "NODE_OPTIONS='--experimental-specifier-resolution=node' tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "start:bundle": "node dist/server/bundle.cjs",
    "check": "npm run clean && npm run type-check && npm run lint && npm run test:all && npm run test:package && npm run audit:prod",
    "test": "jest --testPathIgnorePatterns='(/tests/e2e/|/tests/integration/svg-export\\.test\\.ts$)' && npm run test:renderer",
    "test:all": "npm run clean && npm run build && MCP_BPMN_LAYOUT_CANDIDATES=1 jest --coverage --testPathIgnorePatterns='(/tests/e2e/|/tests/integration/svg-export\\.test\\.ts$)' && npm run test:e2e:compiled && npm run test:renderer && npm run test:installer && npm run test:ralph",
    "test:contract": "jest --runTestsByPath tests/contracts/engine-contract.test.ts && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.puppeteer.config.js --runTestsByPath tests/integration/svg-export.test.ts",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration && npm run test:renderer",
    "test:e2e": "npm run clean && npm run build && npm run test:e2e:compiled",
    "test:e2e:compiled": "jest --runInBand tests/e2e",
    "test:package": "node scripts/package-smoke.mjs",
    "contract:update": "npm run build && node scripts/package-smoke.mjs --update-fingerprint",
    "test:codex-plugin": "node scripts/validate-codex-plugin.mjs",
    "test:claude-plugin": "node scripts/validate-claude-plugin.mjs",
    "test:installer": "sh tests/install-agent-integrations.test.sh",
    "test:ralph": "bash ralph-loop/tests/loop_test.sh",
    "test:layout-candidates": "MCP_BPMN_LAYOUT_CANDIDATES=1 jest --runTestsByPath tests/integration/layout-candidates.test.ts",
    "test:evaluations": "jest --runTestsByPath tests/integration/agent-evaluations.test.ts",
    "eval:codex": "node scripts/run-agent-evals.mjs --client codex",
    "eval:claude": "node scripts/run-agent-evals.mjs --client claude",
    "test:renderer": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.puppeteer.config.js",
    "test:watch": "jest --testPathIgnorePatterns='(/tests/e2e/|/tests/integration/svg-export\\.test\\.ts$)' --watch",
    "test:coverage": "jest --testPathIgnorePatterns='(/tests/e2e/|/tests/integration/svg-export\\.test\\.ts$)' --coverage && npm run test:renderer",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint --max-warnings 0 --ext .ts,.js,.cjs,.mjs .",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "bpmn",
    "bpmn-js",
    "ai",
    "model-context-protocol"
  ],
  "author": {
    "name": "Alice V.",
    "email": "ooisee@gmail.com",
    "url": "https://github.com/oisee"
  },
  "maintainers": [
    {
      "name": "Alice V.",
      "email": "ooisee@gmail.com",
      "url": "https://github.com/oisee"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oisee/mcp-bpmn.git"
  },
  "homepage": "https://github.com/oisee/mcp-bpmn#readme",
  "bugs": {
    "url": "https://github.com/oisee/mcp-bpmn/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.26.0",
    "bpmn-auto-layout": "2.0.0-alpha.2",
    "bpmn-js": "17.11.1",
    "bpmn-moddle": "^9.0.1",
    "camunda-bpmn-moddle": "7.0.1",
    "puppeteer": "25.8.0",
    "uuid": "^11.1.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.8.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "bpmn-auto-layout-stable": "npm:bpmn-auto-layout@1.3.0",
    "esbuild": "^0.25.5",
    "esbuild-node-externals": "^1.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "yet-another-bpmn-auto-layout": "2.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
